# YouTube Data API v3 key (https://console.cloud.google.com/apis/credentials,
# with the "YouTube Data API v3" enabled on the project).
YOUTUBE_API_KEY=

# Give EITHER a specific live video id (the "v=" part of the stream's
# watch URL) — simplest and most reliable —
YOUTUBE_LIVE_VIDEO_ID=

# OR a channel id, and the server will look up that channel's current live
# broadcast automatically (used only when YOUTUBE_LIVE_VIDEO_ID is empty).
YOUTUBE_CHANNEL_ID=

# Port the BFF listens on. The Vite app's VITE_SERVER_URL should point here.
PORT=8787

# How many "votes" a Super Chat (paid message) is worth per whole currency
# unit paid (no currency conversion is done — this is "per dollar/euro/leu/
# etc. as YouTube reports it"). A Super Chat's !vote always counts for at
# least 10 votes even below this ratio. Default: 10.
SUPERCHAT_VOTES_PER_UNIT=10
